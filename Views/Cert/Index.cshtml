@model List<Certificate>
@{ ViewData["Title"] = "Chứng thư số"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Chủ thể (CN)</th><th>Serial</th><th>Hiệu lực đến</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                var (t, css) = Ui.Cert(c);
                <tr>
                    <td class="fw-semibold" style="cursor:pointer" onclick="location.href='/Cert/Detail/@c.Id'">@c.Subject</td>
                    <td class="small mono">@c.Serial</td>
                    <td class="small">@c.NotAfter.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-@css">@t</span></td>
                    <td class="text-end">
                        @if (c.Status == CertStatus.Active)
                        {
                            <form asp-action="Revoke" method="post" class="d-inline" onsubmit="return confirm('Thu hồi chứng thư này?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><button class="btn btn-sm btn-outline-danger">Thu hồi</button></form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có chứng thư.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Tạo chứng thư (RSA 2048)</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="subject" class="form-control" placeholder="Chủ thể / CN (VD Công ty ABC) *" required /></div>
            <div class="mb-3"><label class="form-label small text-muted">Số năm hiệu lực</label><input name="years" type="number" value="3" class="form-control" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-award me-1"></i>Sinh cặp khóa &amp; cấp CTS</button>
        </form>
        <div class="small text-muted mt-3">Sinh cặp khóa RSA 2048; khóa riêng lưu tại server (demo — thực tế nằm trong USB token/HSM).</div>
    </div></div></div>
</div>
