@model List<Invoice>
@{
    ViewData["Title"] = "Ký hóa đơn";
    var certs = ViewBag.Certs as List<Certificate> ?? new();
    var dash = ViewBag.Dash as InvoiceDash;
    var life = ViewBag.Lifecycle as InvoiceLifecycleDash;
    var templates = ViewBag.Templates as List<InvoiceTemplate> ?? new();
    var cur = ViewBag.Status as int?;
    string Badge(SignStatus s) => s switch
    {
        SignStatus.Signed => "success",
        SignStatus.Failed => "danger",
        SignStatus.Processing => "warning",
        _ => "secondary"
    };
    string Label(SignStatus s) => s switch
    {
        SignStatus.Signed => "Đã ký",
        SignStatus.Failed => "Thất bại",
        SignStatus.Processing => "Đang xử lý",
        _ => "Chờ ký"
    };
    string LifeBadge(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Issued => "success",
        InvoiceStatus.Approved => "info",
        InvoiceStatus.Canceled => "danger",
        InvoiceStatus.Deleted => "dark",
        _ => "secondary"
    };
    string LifeLabel(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Issued => "Đã phát hành",
        InvoiceStatus.Approved => "Đã duyệt",
        InvoiceStatus.Canceled => "Đã hủy",
        InvoiceStatus.Deleted => "Đã xóa",
        _ => "Chờ xử lý"
    };
}
@if (dash != null)
{
    <div class="row g-3 mb-3">
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Tổng</div><div class="stat-num">@dash.Total</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Chờ ký</div><div class="stat-num text-secondary">@dash.Pending</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đang xử lý</div><div class="stat-num text-warning">@dash.Processing</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã ký</div><div class="stat-num text-success">@dash.Signed</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Thất bại</div><div class="stat-num text-danger">@dash.Failed</div></div></div></div>
    </div>
}
@if (life != null)
{
    <div class="row g-3 mb-3">
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Tổng</div><div class="stat-num">@life.Total</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Chờ xử lý</div><div class="stat-num text-secondary">@life.Pending</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã duyệt</div><div class="stat-num text-info">@life.Approved</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã phát hành</div><div class="stat-num text-success">@life.Issued</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã hủy</div><div class="stat-num text-danger">@life.Canceled</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã xóa</div><div class="stat-num text-dark">@life.Deleted</div></div></div></div>
    </div>
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold mb-0">Hóa đơn &amp; trạng thái ký</h6>
            <div class="btn-group btn-group-sm">
                <a class="btn btn-outline-secondary @(cur == null ? "active" : "")" href="/Invoice">Tất cả</a>
                <a class="btn btn-outline-secondary @(cur == 0 ? "active" : "")" href="/Invoice?status=0">Chờ ký</a>
                <a class="btn btn-outline-secondary @(cur == 2 ? "active" : "")" href="/Invoice?status=2">Đã ký</a>
                <a class="btn btn-outline-secondary @(cur == 3 ? "active" : "")" href="/Invoice?status=3">Thất bại</a>
            </div>
        </div>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Số tra cứu</th><th>Khách hàng</th><th class="text-end">Thanh toán</th><th>Vòng đời</th><th>Trạng thái ký</th><th>Người ký</th><th></th></tr></thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td class="fw-semibold mono">@i.InvoiceCode@if (!string.IsNullOrEmpty(i.InvoiceNo)) { <div class="text-muted mono" style="font-size:11px">Số HĐ: @i.InvoiceNo</div> }@if (i.InvoiceDateUTC != null) { <div class="text-muted" style="font-size:11px">Ngày HĐ: @i.InvoiceDateUTC.Value.ToString("dd/MM/yyyy")</div> }</td>
                    <td class="small">@i.CustomerName<div class="text-muted mono" style="font-size:11px">MST @i.TaxCode</div></td>
                    <td class="text-end small">@i.TotalValPmt.ToString("N0")</td>
                    <td><span class="badge bg-@LifeBadge(i.Status)">@LifeLabel(i.Status)</span>
                        @if (i.Status == InvoiceStatus.Canceled && !string.IsNullOrEmpty(i.CancelReason)) { <div class="text-danger" style="font-size:11px">@i.CancelReason</div> }
                        @if (i.Status == InvoiceStatus.Deleted && !string.IsNullOrEmpty(i.DeleteReason)) { <div class="text-muted" style="font-size:11px">@i.DeleteReason</div> }
                        @if (!i.FlagChange) { <div class="text-warning" style="font-size:11px"><i class="bi bi-arrow-repeat"></i> Đã thay thế@(string.IsNullOrEmpty(i.ChangeReason) ? "" : ": " + i.ChangeReason)</div> }
                        @if (i.SourceInvoiceCode != SourceInvoiceCode.Root) { <div class="text-info" style="font-size:11px"><i class="bi bi-pencil-square"></i> @(i.SourceInvoiceCode == SourceInvoiceCode.Adj ? "HĐ điều chỉnh" : "HĐ thay thế")@(i.InvoiceAdjType == InvoiceAdjType.AdjIncrease ? " (Tăng)" : i.InvoiceAdjType == InvoiceAdjType.AdjDecrease ? " (Giảm)" : "")@(string.IsNullOrEmpty(i.RefNo) ? "" : " — gốc: " + i.RefNo)</div> }
                    </td>
                    <td><span class="badge bg-@Badge(i.SignStatus)">@Label(i.SignStatus)</span>
                        @if (i.SignStatus == SignStatus.Failed && !string.IsNullOrEmpty(i.SignError)) { <div class="text-danger" style="font-size:11px">@i.SignError</div> }
                    </td>
                    <td class="small">@(i.SignBy ?? "—")@if (i.SignDTimeUTC != null) { <div class="text-muted" style="font-size:11px">@i.SignDTimeUTC.Value.ToLocalTime().ToString("dd/MM HH:mm")</div> }</td>
                    <td class="text-end">
                        @if (i.SignStatus != SignStatus.Signed && i.Status != InvoiceStatus.Canceled && certs.Count > 0)
                        {
                            <form asp-action="Sign" method="post" class="d-inline">@Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@i.Id" />
                                <select name="certId" class="form-select form-select-sm d-inline-block" style="width:auto">
                                    @foreach (var c in certs) { <option value="@c.Id">@c.Subject</option> }
                                </select>
                                <button class="btn btn-sm btn-primary">Ký</button>
                            </form>
                        }
                        else if (i.SignStatus == SignStatus.Signed)
                        {
                            <span class="text-success small"><i class="bi bi-patch-check-fill"></i> @i.SignSerial</span>
                        }
                        @if (i.Status == InvoiceStatus.Pending && string.IsNullOrEmpty(i.InvoiceNo) && templates.Count > 0)
                        {
                            <button class="btn btn-sm btn-outline-primary ms-1" data-bs-toggle="modal" data-bs-target="#alloc-@i.Id"><i class="bi bi-123"></i> Cấp số</button>
                            <div class="modal fade" id="alloc-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                <form asp-action="Allocate" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Cấp số hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="mb-2"><label class="form-label small text-muted">Mẫu số hóa đơn *</label>
                                            <select name="tInvoiceCode" class="form-select mono" required>
                                                @foreach (var t in templates) { <option value="@t.TInvoiceCode">@t.TInvoiceCode — @t.InvoiceSerial (còn @t.QtyRemain số)</option> }
                                            </select></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Ngày hóa đơn *</label><input name="invoiceDateUtc" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Người cấp số</label><input name="allocateBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                        <div class="small text-muted">Số HĐ kế tiếp = StartInvoiceNo + QtyUsed; ngày HĐ phải &gt;= ngày cấp gần nhất và không ở tương lai (port từ InBrand <span class="mono">Invoice_Invoice_AllocatedInvX</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary btn-sm">Xác nhận cấp số</button></div>
                                </form>
                            </div></div></div>
                        }
                        @if (i.Status == InvoiceStatus.Pending && !string.IsNullOrEmpty(i.InvoiceNo))
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-1" data-bs-toggle="modal" data-bs-target="#upd-@i.Id"><i class="bi bi-calculator"></i> Cập nhật</button>
                            <div class="modal fade" id="upd-@i.Id" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
                                <form asp-action="UpdateAfterAllocated" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Cập nhật hóa đơn sau cấp số @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="row g-2">
                                            <div class="col-md-6"><label class="form-label small text-muted">Phương thức thanh toán</label><input name="paymentMethodCode" class="form-control mono" value="@i.PaymentMethodCode" placeholder="VD: TM/CK" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Ngày hóa đơn</label><input name="invoiceDateUtc" type="date" class="form-control" value="@((i.InvoiceDateUTC ?? DateTime.Today).ToString("yyyy-MM-dd"))" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Mã khách hàng (NNT)</label><input name="customerNNTCode" class="form-control mono" value="@i.CustomerNNTCode" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Tên khách hàng</label><input name="customerNNTName" class="form-control" value="@i.CustomerNNTName" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">MST khách hàng</label><input name="customerMST" class="form-control mono" value="@i.CustomerMST" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Người mua hàng</label><input name="customerNNTBuyerName" class="form-control" value="@i.CustomerNNTBuyerName" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Địa chỉ</label><input name="customerNNTAddress" class="form-control" value="@i.CustomerNNTAddress" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Điện thoại</label><input name="customerNNTPhone" class="form-control" value="@i.CustomerNNTPhone" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Email</label><input name="customerNNTEmail" class="form-control" value="@i.CustomerNNTEmail" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Ngân hàng</label><input name="customerNNTBankName" class="form-control" value="@i.CustomerNNTBankName" /></div>
                                            <div class="col-md-6"><label class="form-label small text-muted">Số tài khoản</label><input name="customerNNTAccNo" class="form-control mono" value="@i.CustomerNNTAccNo" /></div>
                                        </div>
                                        <hr />
                                        <div class="fw-semibold small mb-2">Bảng kê giá trị theo thuế suất</div>
                                        <div class="row g-2">
                                            <div class="col-md-4"><label class="form-label small text-muted">Hàng không chịu thuế</label><input name="valGoodsNotTaxable" type="number" step="1" value="@i.ValGoodsNotTaxable" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Hàng không chịu thuế GTGT</label><input name="valGoodsNotChargeTax" type="number" step="1" value="@i.ValGoodsNotChargeTax" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Giá trị hàng VAT 5%</label><input name="valGoodsVAT5" type="number" step="1" value="@i.ValGoodsVAT5" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Tiền thuế VAT 5%</label><input name="valVAT5" type="number" step="1" value="@i.ValVAT5" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Giá trị hàng VAT 10%</label><input name="valGoodsVAT10" type="number" step="1" value="@i.ValGoodsVAT10" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Tiền thuế VAT 10%</label><input name="valVAT10" type="number" step="1" value="@i.ValVAT10" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Tổng giá trị hàng hóa</label><input name="totalValInvoice" type="number" step="1" value="@i.TotalValInvoice" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Tổng tiền thuế GTGT</label><input name="totalValVAT" type="number" step="1" value="@i.TotalValVAT" class="form-control" /></div>
                                            <div class="col-md-4"><label class="form-label small text-muted">Tổng thanh toán</label><input name="totalValPmt" type="number" step="1" value="@i.TotalValPmt" class="form-control" /></div>
                                        </div>
                                        <div class="small text-muted mt-2">Chỉ cập nhật được khi hóa đơn ở PENDING, đã có số, là hóa đơn gốc; ngày HĐ không ở tương lai và nằm giữa ngày hóa đơn liền trước/liền sau cùng mẫu số (port từ InBrand <span class="mono">Invoice_Invoice_UpdAfterAllocatedX</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary btn-sm">Lưu cập nhật</button></div>
                                </form>
                            </div></div></div>
                        }
                        @if (i.Status == InvoiceStatus.Pending)
                        {
                            <button class="btn btn-sm btn-outline-info ms-1" data-bs-toggle="modal" data-bs-target="#approve-@i.Id"><i class="bi bi-check2-square"></i> Duyệt</button>
                            <div class="modal fade" id="approve-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                <form asp-action="Approve" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Duyệt hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="mb-2"><label class="form-label small text-muted">Số hóa đơn (InvoiceNo) *</label><input name="invoiceNo" class="form-control mono" placeholder="VD: 00000001" required /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Người duyệt</label><input name="apprBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                        <div class="small text-muted">Chỉ duyệt được khi hóa đơn ở trạng thái PENDING và đã có số hóa đơn (port từ InBrand <span class="mono">Invoice_Invoice_ApprovedMultiX</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-info btn-sm">Xác nhận duyệt</button></div>
                                </form>
                            </div></div></div>
                        }
                        @if (i.Status == InvoiceStatus.Approved)
                        {
                            <button class="btn btn-sm btn-outline-success ms-1" data-bs-toggle="modal" data-bs-target="#issue-@i.Id"><i class="bi bi-send-check"></i> Phát hành</button>
                            <div class="modal fade" id="issue-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                <form asp-action="Issue" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Phát hành hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="mb-2"><label class="form-label small text-muted">Người phát hành</label><input name="issuedBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                        <div class="small text-muted">Chỉ phát hành được khi hóa đơn ở trạng thái APPROVED (port từ InBrand <span class="mono">Invoice_Invoice_IssuedXMulti</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-success btn-sm">Xác nhận phát hành</button></div>
                                </form>
                            </div></div></div>
                        }
                        @if (i.Status == InvoiceStatus.Pending || i.Status == InvoiceStatus.Approved)
                        {
                            <button class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#cancel-@i.Id"><i class="bi bi-x-circle"></i> Hủy</button>
                            <div class="modal fade" id="cancel-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                <form asp-action="Cancel" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Hủy hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="mb-2"><label class="form-label small text-muted">Lý do hủy</label><input name="reason" class="form-control" placeholder="VD: sai thông tin khách hàng" /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Người hủy</label><input name="cancelBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                        <div class="small text-muted">Chỉ hủy được khi hóa đơn ở trạng thái PENDING/APPROVED (port từ InBrand <span class="mono">Invoice_Invoice_Cancel</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-danger btn-sm">Xác nhận hủy</button></div>
                                </form>
                            </div></div></div>
                        }
                        @if (i.Status == InvoiceStatus.Issued)
                        {
                            <button class="btn btn-sm btn-outline-dark ms-1" data-bs-toggle="modal" data-bs-target="#delete-@i.Id"><i class="bi bi-trash"></i> Xóa</button>
                            <div class="modal fade" id="delete-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                <form asp-action="Delete" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Xóa hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="mb-2"><label class="form-label small text-muted">Lý do xóa</label><input name="reason" class="form-control" placeholder="VD: hóa đơn sai, đã thay thế" /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Người xóa</label><input name="deleteBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">File đính kèm (tùy chọn)</label><input name="attachedDelFilePath" class="form-control mono" placeholder="VD: /UploadedFiles/Inv_IVID/xxx.pdf" /></div>
                                        <div class="small text-muted">Chỉ xóa được khi hóa đơn ở trạng thái ISSUED (đã phát hành); đã DELETED thì bỏ qua (port từ InBrand <span class="mono">Invoice_Invoice_Deleted</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-dark btn-sm">Xác nhận xóa</button></div>
                                </form>
                            </div></div></div>
                            @if (i.FlagChange)
                            {
                                <button class="btn btn-sm btn-outline-warning ms-1" data-bs-toggle="modal" data-bs-target="#change-@i.Id"><i class="bi bi-arrow-repeat"></i> Thay thế</button>
                                <div class="modal fade" id="change-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                    <form asp-action="Change" method="post">@Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <div class="modal-header"><h6 class="modal-title">Đánh dấu thay thế hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                        <div class="modal-body text-start">
                                            <div class="mb-2"><label class="form-label small text-muted">Lý do thay thế</label><input name="reason" class="form-control" placeholder="VD: điều chỉnh sai sót, thay thế bằng HĐ mới" /></div>
                                            <div class="mb-2"><label class="form-label small text-muted">Người thay thế</label><input name="changeBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                            <div class="small text-muted">Chỉ đánh dấu được khi hóa đơn ở trạng thái ISSUED và chưa bị thay thế (FlagChange Active); sau đó FlagChange = Inactive (port từ InBrand <span class="mono">Invoice_Invoice_ChangeX</span>).</div>
                                        </div>
                                        <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-warning btn-sm">Xác nhận thay thế</button></div>
                                    </form>
                                </div></div></div>
                            }
                            <button class="btn btn-sm btn-outline-info ms-1" data-bs-toggle="modal" data-bs-target="#adjust-@i.Id"><i class="bi bi-pencil-square"></i> Điều chỉnh</button>
                            <div class="modal fade" id="adjust-@i.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                <form asp-action="Adjust" method="post">@Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <div class="modal-header"><h6 class="modal-title">Đánh dấu điều chỉnh/thay thế hóa đơn @i.InvoiceCode</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body text-start">
                                        <div class="mb-2"><label class="form-label small text-muted">Nguồn gốc hóa đơn</label>
                                            <select name="sourceInvoiceCode" class="form-select">
                                                <option value="2">Hóa đơn điều chỉnh (INVOICEADJ — gốc phải ISSUED)</option>
                                                <option value="1">Hóa đơn thay thế (INVOICEREPLACE — gốc phải DELETED)</option>
                                            </select></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Loại điều chỉnh</label>
                                            <select name="invoiceAdjType" class="form-select">
                                                <option value="0">Bình thường (NORMAL)</option>
                                                <option value="1">Điều chỉnh Tăng (ADJINCREASE)</option>
                                                <option value="2">Điều chỉnh Giảm (ADJDESCREASE)</option>
                                            </select></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Số tra cứu hóa đơn gốc (RefNo)</label><input name="refNo" class="form-control mono" placeholder="VD: 1C26TAA-00000001" /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Lý do</label><input name="reason" class="form-control" placeholder="VD: điều chỉnh sai sót" /></div>
                                        <div class="mb-2"><label class="form-label small text-muted">Người điều chỉnh</label><input name="adjustBy" class="form-control" placeholder="VD: ketoan01" /></div>
                                        <div class="small text-muted">Điều chỉnh Tăng/Giảm bắt buộc có RefNo; hóa đơn gốc chỉ được điều chỉnh/thay thế một lần (port từ InBrand <span class="mono">Invoice_Invoice_SaveX</span>).</div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-info btn-sm">Xác nhận</button></div>
                                </form>
                            </div></div></div>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có hóa đơn.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Tạo hóa đơn chờ ký</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="invoiceCode" class="form-control mono" placeholder="Số tra cứu (VD 1C26TAA-00000001) *" required /></div>
            <div class="mb-2"><input name="taxCode" class="form-control mono" placeholder="MST người nộp thuế" /></div>
            <div class="mb-2"><input name="customerName" class="form-control" placeholder="Tên khách hàng" /></div>
            <div class="mb-2"><input name="totalValPmt" type="number" step="1000" value="0" class="form-control" placeholder="Tiền thanh toán" /></div>
            <div class="mb-3"><textarea name="content" class="form-control" rows="3" placeholder="Nội dung hóa đơn (bản rõ để ký) *" required></textarea></div>
            <button class="btn btn-primary w-100"><i class="bi bi-file-earmark-plus me-1"></i>Tạo hóa đơn</button>
        </form>
        <div class="small text-muted mt-3">Ký hóa đơn bằng <span class="mono">SHA1withRSA</span> (thuật toán hóa đơn điện tử). Vòng đời trạng thái ký port từ InBrand <span class="mono">OS_Invoice_InvoiceTemp</span>.</div>
    </div></div></div>
</div>