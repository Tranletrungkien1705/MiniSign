@{ ViewData["Title"] = "Bảng điều khiển"; var d = (SignDash)ViewBag.Dash; }
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-4"><div class="card"><div class="card-body"><div class="text-muted small">Chứng thư hiệu lực</div><div class="stat-num text-success">@d.Active<span class="text-muted" style="font-size:15px">/@d.Certs</span></div></div></div></div>
    <div class="col-6 col-lg-4"><div class="card"><div class="card-body"><div class="text-muted small">Lượt ký</div><div class="stat-num" style="color:#b45309">@d.Signs</div></div></div></div>
    <div class="col-12 col-lg-4"><div class="card"><div class="card-body d-flex gap-2 align-items-center h-100">
        <a href="/Sign" class="btn btn-primary flex-fill"><i class="bi bi-pen me-1"></i>Ký</a>
        <a href="/Verify" class="btn btn-outline-primary flex-fill"><i class="bi bi-shield-check me-1"></i>Xác minh</a>
    </div></div></div>
</div>
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2"><h6 class="fw-bold mb-0">Chứng thư số</h6><a href="/Cert" class="small">Tất cả →</a></div>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Chủ thể</th><th>Serial</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var c in d.RecentCerts)
            {
                var (t, css) = Ui.Cert(c);
                <tr style="cursor:pointer" onclick="location.href='/Cert/Detail/@c.Id'"><td>@c.Subject</td><td class="small mono">@c.Serial</td><td><span class="badge bg-@css">@t</span></td></tr>
            }
            @if (d.RecentCerts.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-3">Chưa có chứng thư. <a href="/Cert">Tạo →</a></td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-2">Lượt ký gần đây</h6>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Tài liệu</th><th>Chứng thư</th><th>Thời gian</th></tr></thead>
            <tbody>
            @foreach (var l in d.RecentSigns)
            {
                <tr><td class="small">@l.DocName</td><td class="small">@l.Certificate?.Subject</td><td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td></tr>
            }
            @if (d.RecentSigns.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-3">Chưa có lượt ký.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
