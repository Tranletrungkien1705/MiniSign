@model List<InvoiceLicense>
@{
    ViewData["Title"] = "Hạn mức cấp số";
    var dash = ViewBag.Dash as LicenseDash;
}
@if (dash != null)
{
    <div class="row g-3 mb-3">
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Số MST</div><div class="stat-num">@dash.Total</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Hạn mức tổng</div><div class="stat-num text-primary">@dash.TotalQty.ToString("N0")</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã cấp dải số</div><div class="stat-num text-info">@dash.TotalQtyIssued.ToString("N0")</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Đã dùng</div><div class="stat-num text-success">@dash.TotalQtyUsed.ToString("N0")</div></div></div></div>
        <div class="col"><div class="card"><div class="card-body py-3"><div class="text-muted small">Còn lại</div><div class="stat-num text-warning">@dash.QtyRemain.ToString("N0")</div></div></div></div>
    </div>
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Hạn mức cấp số hóa đơn theo MST</h6>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>MST</th><th class="text-end">Hạn mức</th><th class="text-end">Đã cấp dải</th><th class="text-end">Đã dùng</th><th class="text-end">Còn lại</th><th>Hiệu lực</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td class="fw-semibold mono">@l.MST@if (!string.IsNullOrEmpty(l.NetworkID)) { <div class="text-muted" style="font-size:11px">Mạng: @l.NetworkID</div> }</td>
                    <td class="text-end mono">@l.TotalQty.ToString("N0")</td>
                    <td class="text-end mono">@l.TotalQtyIssued.ToString("N0")</td>
                    <td class="text-end mono">@l.TotalQtyUsed.ToString("N0")</td>
                    <td class="text-end mono fw-semibold @(l.QtyRemain <= 0 ? "text-danger" : "text-success")">@l.QtyRemain.ToString("N0")</td>
                    <td>@if (l.FlagActive) { <span class="badge bg-success">Hiệu lực</span> } else { <span class="badge bg-secondary">Ngừng</span> }</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#inc-@l.Id"><i class="bi bi-plus-circle"></i> Tăng</button>
                        <form asp-action="Recompute" method="post" class="d-inline">@Html.AntiForgeryToken()
                            <input type="hidden" name="mst" value="@l.MST" />
                            <button class="btn btn-sm btn-outline-secondary ms-1"><i class="bi bi-arrow-repeat"></i> Tính lại</button>
                        </form>
                        <div class="modal fade" id="inc-@l.Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                            <form asp-action="Increase" method="post">@Html.AntiForgeryToken()
                                <input type="hidden" name="mst" value="@l.MST" />
                                <div class="modal-header"><h6 class="modal-title">Tăng hạn mức MST @l.MST</h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                                <div class="modal-body text-start">
                                    <div class="mb-2"><label class="form-label small text-muted">Số lượng tăng (Qty) *</label><input name="qty" type="number" min="0" step="1" value="0" class="form-control" required /></div>
                                    <div class="mb-2"><label class="form-label small text-muted">Người cập nhật</label><input name="by" class="form-control" placeholder="VD: ketoan01" /></div>
                                    <div class="small text-muted">TotalQty += Qty; Qty phải &gt;= 0 (port từ InBrand <span class="mono">Invoice_license_IncreaseQtyX</span>).</div>
                                </div>
                                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button><button class="btn btn-primary btn-sm">Xác nhận tăng</button></div>
                            </form>
                        </div></div></div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có hạn mức. Tạo mới bằng cách tăng hạn mức cho một MST.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Tăng hạn mức cho MST</h6>
        <form asp-action="Increase" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="mst" class="form-control mono" placeholder="MST người nộp thuế (VD 0101234567) *" required /></div>
            <div class="mb-2"><input name="qty" type="number" min="0" step="1" value="0" class="form-control" placeholder="Số lượng tăng *" required /></div>
            <div class="mb-3"><input name="by" class="form-control" placeholder="Người cập nhật" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-circle me-1"></i>Tăng hạn mức</button>
        </form>
        <div class="small text-muted mt-3">Hạn mức cấp số theo MST port từ InBrand <span class="mono">Invoice_license</span>. Bất biến: <span class="mono">TotalQty &gt;= TotalQtyIssued</span> và <span class="mono">TotalQtyUsed &lt;= TotalQtyIssued</span>.</div>
    </div></div></div>
</div>
